#!/bin/sh

# manifest.json から現在のバージョンを取得 (例: 1.0.0)
VERSION=$(grep '"version":' manifest.json | sed -E 's/.*"version": "([^"]+)".*/\1/')

if [ -z "$VERSION" ]; then
    echo "Error: Could not find version in manifest.json"
    exit 1
fi

# バージョンをパッチ、マイナー、メジャーに分解
MAJOR=$(echo $VERSION | cut -d. -f1)
MINOR=$(echo $VERSION | cut -d. -f2)
PATCH=$(echo $VERSION | cut -d. -f3)

# パッチバージョンをインクリメント
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

echo "Bumping version from $VERSION to $NEW_VERSION..."

# manifest.json を更新
sed -i -E "s/\"version\": \"$VERSION\"/\"version\": \"$NEW_VERSION\"/" manifest.json

# sw.js の CACHE_NAME を更新 (webtools-vX.Y.Z)
sed -i -E "s/webtools-v$VERSION/webtools-v$NEW_VERSION/" sw.js

# 更新したファイルをステージングに追加
git add manifest.json sw.js
